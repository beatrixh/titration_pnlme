<DATAFILE>

[FILEINFO]
file={path='../../../../input_data/retagged_data/six_plates_m4b_m5b_estimates_2026-09-13.csv'}
delimiter = comma
header={id, time, monolix_id_update, specrole, concentration, rlu, run_id, mab_virus, binary_vc, binary_cc, binary_sample, plate_row, plate_col, goes_down, a_m4b, c_m4b, a_m5b, c_m5b, m_m5b, cc_mean}

[CONTENT]
id = {use=identifier}
time = {use=time}
concentration = {use=regressor}
rlu = {use=observation, yname={'0', '1'}, type={continuous, continuous}}
run_id = {use=covariate, type=categorical}
mab_virus = {use=covariate, type=categorical}
binary_cc = {use=observationtype}
plate_row = {use=regressor}
plate_col = {use=regressor}
goes_down = {use=covariate, type=categorical}
a_m5b = {use=regressor}
c_m5b = {use=regressor}
m_m5b = {use=regressor}
cc_mean = {use=regressor}

<MODEL>

[COVARIATE]
input = {goes_down, mab_virus, run_id}

goes_down = {type=categorical, categories={'False', 'True'}}
mab_virus = {type=categorical, categories={'22.0|103', '22.0|276', '22.0|292', '22.0|322', '28.0|103', '28.0|276', '28.0|292', '28.0|322', '32.0|292', '55.0|292', '65.0|103', '65.0|276', '65.0|292', '65.0|322', '69.0|103', '69.0|274', '69.0|276', '69.0|292', '69.0|322', '70.0|274'}}
