_mab_virus_65_0_276, beta_L_gap_mab_virus_65_0_292, beta_L_gap_mab_virus_65_0_322, beta_L_gap_mab_virus_69_0_103, beta_L_gap_mab_virus_69_0_274, beta_L_gap_mab_virus_69_0_276, beta_L_gap_mab_virus_69_0_292, beta_L_gap_mab_virus_69_0_322, beta_L_gap_mab_virus_70_0_274}

