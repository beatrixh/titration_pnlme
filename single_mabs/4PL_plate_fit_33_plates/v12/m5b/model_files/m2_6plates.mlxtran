mab_virus = {type=categorical, categories={'22.0|103', '22.0|276', '22.0|292', '22.0|322', '28.0|103', '28.0|276', '28.0|292', '28.0|322', '32.0|292', '55.0|292', '65.0|103', '65.0|276', '65.0|292', '65.0|322', '69.0|103', '69.0|274', '69.0|276', '69.0|292', '69.0|322', '70.0|274'}}

DEFINITION:
h = {distribution=normal, typical=h_pop, covariate={goes_down, mab_virus}, coefficient={{0, beta_h_goes_down_True}, {0, beta_h_mab_virus_22_0_276, beta_h_mab_virus_22_0_292, beta_h_mab_virus_22_0_322, beta_h_mab_virus_28_0_103, beta_h_mab_virus_28_0_276, beta_h_mab_virus_28_0_292, beta_h_mab_virus_28_0_322, beta_h_mab_virus_32_0_292, beta_h_mab_virus_55_0_292, beta_h_mab_virus_65_0_103, beta_h_mab_virus_65_0_276, beta_h_mab_virus_65_0_292, beta_h_mab_virus_65_0_322, beta_h_mab_virus_69_0_103, beta_h_mab_virus_69_0_274, beta_h_mab_virus_69_0_276, beta_h_mab_virus_69_0_292, beta_h_mab_virus_69_0_322, beta_h_mab_virus_70_0_274}}, sd=omega_h}
f = {distribution=logNormal, typical=f_pop, covariate={goes_down, mab_virus}, coefficient={{0, beta_f_goes_down_True}, {0, beta_f_mab_virus_22_0_276, beta_f_mab_virus_22_0_292, beta_f_mab_virus_22_0_322, beta_f_mab_virus_28_0_103, beta_f_mab_virus_28_0_276, beta_f_mab_virus_28_0_292, beta_f_mab_virus_28_0_322, beta_f_mab_virus_32_0_292, beta_f_mab_virus_55_0_292, beta_f_mab_virus_65_0_103, beta_f_mab_virus_65_0_276, beta_f_mab_virus_65_0_292, beta_f_mab_virus_65_0_322, beta_f_mab_virus_69_0_103, beta_f_mab_virus_69_0_274, beta_f_mab_virus_69_0_276, beta_f_mab_virus_69_0_292, beta_f_mab_virus_69_0_322, beta_f_mab_virus_70_0_274}}, sd=omega_f}
L_gap = {distribution=normal, typical=L_gap_pop, covariate={goes_down, mab_virus}, coefficient={{0, beta_L_gap_goes_down_True}, {0, beta_L_gap_mab_virus_22_0_276, beta_L_gap_mab_virus_22_0_292, beta_L_gap_mab_virus_22_0_322, beta_L_gap_mab_virus_28_0_103, beta_L_gap_mab_virus_28_0_276, beta_L_gap_mab_virus_28_0_292, beta_L_gap_mab_virus_28_0_322, beta_L_gap_mab_virus_32_0_292, beta_L_gap_mab_virus_55_0_292, beta_L_gap_mab_virus_65_0_103, beta_L_gap_mab_virus_65_0_276, beta_L_gap_mab_virus_65_0_292, beta_L_gap_mab_virus_65_0_322, beta_L_gap_mab_virus_69_0_103, beta_L_gap_mab_virus_69_0_274, beta_L_gap_mab_virus_69_0_276, beta_L_gap_mab_virus_69_0_292, beta_L_gap_mab_virus_69_0_322, beta_L_gap_mab_virus_70_0_274}}, sd=omega_L_gap}
L_plate = {distribution=logNormal, typical=L_plate_pop, covariate=run_id, coefficient={0, beta_L_plate_run_id_1159, beta_L_plate_run_id_1197, beta_L_plate_run_id_152, beta_L_plate_run_id_411, beta_L_plate_run_id_462}, no-variability}
U = {distribution=logNormal, typical=U_pop, covariate=run_id, coefficient={0, beta_U_run_id_1159, beta_U_run_id_1197, beta_U_run_id_152, beta_U_run_id_411, beta_U_run_id_462}, no-variability}
alpha = {distribution=normal, typical=alpha_pop, covariate=run_id, coefficient={0, beta_alpha_run_id_1159, beta_alpha_run_id_1197, beta_alpha_run_id_152, beta_alpha_run_id_411, beta_alpha_run_id_462}, no-variability}
m = {distribution=normal, typical=m_pop, covariate=run_id, coefficient={0, beta_m_run_id_1159, beta_m_run_id_1197, beta_m_run_id_152, beta_m_run_id_411, beta_m_run_id_462}, no-variability}
correlation = {level=id, r(h, f)=corr_h_f}

