<DATAFILE>

[FILEINFO]
file={path='../../../../input_data/retagged_data/5_plates_m4b_m5b_estimates_minus_cc_2026-09-24.csv'}
delimiter = comma
header={id, time, monolix_id_update, specrole, concentration, rlu, run_id, mab_virus, binary_vc, binary_cc, binary_sample, plate_row, plate_col, goes_down, a_m4b, c_m4b, a_m5b, c_m5b, m_m5b, cc_mean, mab, virus}

[CONTENT]
id = {use=identifier}
time = {use=time}
concentration = {use=regressor}
rlu = {use=observation, type=continuous}
run_id = {use=covariate, type=categorical}
mab_virus = {use=covariate, type=categorical}
plate_row = {use=regressor}
plate_col = {use=regressor}
c_m5b = {use=regressor}
cc_mean = {use=regressor}

<MODEL>

[COVARIATE]
input = {mab_virus, run_id}

mab_virus = {type=categorical, categories={'22.0|103', '22.0|218', '22.0|276', '28.0|103', '28.0|218', '28.0|276', '6.0|71', '6.0|99', '65.0|103', '65.0|218', '65.0|276', '69.0|103', '69.0|218', '69.0|276', '69.0|71', '69.0|99'}}
run_id = {type=categorical, categories={'1056', '1197', '297', '433', '745'}}

[INDIVIDUAL]
input = {h_pop, f_pop, alpha_pop, omega_f, omega_h, corr_h_f, m_pop, eta_U_pop, omega_eta_U, omega_alpha, omega_m, eta_L_pop, omega_eta_L, mab_virus, beta_f_mab_virus_22_0_218, beta_f_mab_virus_22_0_276, beta_f_mab_virus_28_0_103, beta_f_mab_virus_28_0_218, beta_f_mab_virus_28_0_276, beta_f_mab_virus_6_0_71, beta_f_mab_virus_6_0_99, beta_f_mab_virus_65_0_103, beta_f_mab_virus_65_0_218, beta_f_mab_virus_65_0_276, beta_f_mab_virus_69_0_103, beta_f_mab_virus_69_0_218, beta_f_mab_virus_69_0_276, beta_f_mab_virus_69_0_71, beta_f_mab_virus_69_0_99, beta_h_mab_virus_22_0_218, beta_h_mab_virus_22_0_276, beta_h_mab_virus_28_0_103, beta_h_mab_virus_28_0_218, beta_h_mab_virus_28_0_276, beta_h_mab_virus_6_0_71, beta_h_mab_virus_6_0_99, beta_h_mab_virus_65_0_103, beta_h_mab_virus_65_0_218, beta_h_mab_virus_65_0_276, beta_h_mab_virus_69_0_103, beta_h_mab_virus_69_0_218, beta_h_mab_virus_69_0_276, beta_h_mab_virus_69_0_71, beta_h_mab_virus_69_0_99, beta_eta_L_mab_virus_22_0_218, beta_eta_L_mab_virus_22_0_276, beta_eta_L_mab_virus_28_0_103, beta_eta_L_mab_virus_28_0_218, beta_eta_L_mab_virus_28_0_276, beta_eta_L_mab_virus_6_0_71, beta_eta_L_mab_virus_6_0_99, beta_eta_L_mab_virus_65_0_103, beta_eta_L_mab_virus_65_0_218, beta_eta_L_mab_virus_65_0_276, beta_eta_L_mab_virus_69_0_103, beta_eta_L_mab_virus_69_0_218, beta_eta_L_mab_virus_69_0_276, beta_eta_L_mab_virus_69_0_71, beta_eta_L_mab_virus_69_0_99, run_id, beta_alpha_run_id_1197, beta_alpha_run_id_297, beta_alpha_run_id_433, beta_alpha_run_id_745, beta_m_run_id_1197, beta_m_run_id_297, beta_m_run_id_433, beta_m_run_id_745}

mab_virus = {type=categorical, categories={'22.0|103', '22.0|218', '22.0|276', '28.0|103', '28.0|218', '28.0|276', '6.0|71', '6.0|99', '65.0|103', '65.0|218', '65.0|276', '69.0|103', '69.0|218', '69.0|276', '69.0|71', '69.0|99'}}
run_id = {type=categorical, categories={'1056', '1197', '297', '433', '745'}}

DEFINITION:
h = {distribution=normal, typical=h_pop, covariate=mab_virus, coefficient={0, beta_h_mab_virus_22_0_218, beta_h_mab_virus_22_0_276, beta_h_mab_virus_28_0_103, beta_h_mab_virus_28_0_218, beta_h_mab_virus_28_0_276, beta_h_mab_virus_6_0_71, beta_h_mab_virus_6_0_99, beta_h_mab_virus_65_0_103, beta_h_mab_virus_65_0_218, beta_h_mab_virus_65_0_276, beta_h_mab_virus_69_0_103, beta_h_mab_virus_69_0_218, beta_h_mab_virus_69_0_276, beta_h_mab_virus_69_0_71, beta_h_mab_virus_69_0_99}, sd=omega_h}
f = {distribution=logNormal, typical=f_pop, covariate=mab_virus, coefficient={0, beta_f_mab_virus_22_0_218, beta_f_mab_virus_22_0_276, beta_f_mab_virus_28_0_103, beta_f_mab_virus_28_0_218, beta_f_mab_virus_28_0_276, beta_f_mab_virus_6_0_71, beta_f_mab_virus_6_0_99, beta_f_mab_virus_65_0_103, beta_f_mab_virus_65_0_218, beta_f_mab_virus_65_0_276, beta_f_mab_virus_69_0_103, beta_f_mab_virus_69_0_218, beta_f_mab_virus_69_0_276, beta_f_mab_virus_69_0_71, beta_f_mab_virus_69_0_99}, sd=omega_f}
alpha = {distribution=normal, typical=alpha_pop, covariate=run_id, coefficient={0, beta_alpha_run_id_1197, beta_alpha_run_id_297, beta_alpha_run_id_433, beta_alpha_run_id_745}, sd=omega_alpha}
m = {distribution=logNormal, typical=m_pop, covariate=run_id, coefficient={0, beta_m_run_id_1197, beta_m_run_id_297, beta_m_run_id_433, beta_m_run_id_745}, sd=omega_m}
eta_U = {distribution=logNormal, typical=eta_U_pop, sd=omega_eta_U}
eta_L = {distribution=logNormal, typical=eta_L_pop, covariate=mab_virus, coefficient={0, beta_eta_L_mab_virus_22_0_218, beta_eta_L_mab_virus_22_0_276, beta_eta_L_mab_virus_28_0_103, beta_eta_L_mab_virus_28_0_218, beta_eta_L_mab_virus_28_0_276, beta_eta_L_mab_virus_6_0_71, beta_eta_L_mab_virus_6_0_99, beta_eta_L_mab_virus_65_0_103, beta_eta_L_mab_virus_65_0_218, beta_eta_L_mab_virus_65_0_276, beta_eta_L_mab_virus_69_0_103, beta_eta_L_mab_virus_69_0_218, beta_eta_L_mab_virus_69_0_276, beta_eta_L_mab_virus_69_0_71, beta_eta_L_mab_virus_69_0_99}, sd=omega_eta_L}
correlation = {level=id, r(h, f)=corr_h_f}

[LONGITUDINAL]
input = {a}

file = '../4pl_plate_fit_v14.txt'

DEFINITION:
rlu = {distribution=normal, prediction=RLU_sample_vc, errorModel=constant(a)}

