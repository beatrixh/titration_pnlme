<DATAFILE>

[FILEINFO]
file={path='../../../input_data/retagged_data/five_plates_2026-08-26.csv'}
delimiter = comma
header={run_id, run_name, plate_row, plate_col, rlu, min_diff, specrole, run, virus_name, concentration, monolix_id, rlu_max, rlu_min, rlu_norm, virus_col, mab, mablot, mab_virus, goes_down, virus_cc, id_unique, monolix_id_update, id_unique_update, mean_vc, mean_cc, binary_vc, binary_cc, binary_sample}

[CONTENT]
run_id = {use=covariate, type=categorical}
plate_row = {use=regressor}
plate_col = {use=regressor}
rlu = {use=observation, type=continuous}
concentration = {use=time}
mab_virus = {use=covariate, type=categorical}
goes_down = {use=covariate, type=categorical}
monolix_id_update = {use=identifier}
binary_vc = {use=regressor}
binary_cc = {use=regressor}
binary_sample = {use=regressor}

<MODEL>

[POPULATION]
DEFINITION:
L_gap_pop = {distribution=logNormal, typical=0.0001, sd=1}
alpha_pop = {distribution=normal, typical=0.603, sd=1}

[COVARIATE]
input = {goes_down, mab_virus, run_id}

goes_down = {type=categorical, categories={'False', 'True'}}
mab_virus = {type=categorical, categories={'22.0|103', '22.0|292', '22.0|322', '28.0|103', '28.0|292', '28.0|322', '6.0|233', '65.0|103', '65.0|292', '65.0|322', '69.0|103', '69.0|233', '69.0|274', '69.0|292', '69.0|322', '70.0|274'}}
run_id = {type=categorical, categories={'1159', '1197', '152', '411', '705'}}

[INDIVIDUAL]
input = {U_pop, omega_U, L_pop, L_gap_pop, omega_L_gap, h_pop, omega_h, f_pop, omega_f, alpha_pop, goes_down, beta_U_goes_down_True, beta_L_gap_goes_down_True, mab_virus, beta_U_mab_virus_22_0_292, beta_U_mab_virus_22_0_322, beta_U_mab_virus_28_0_103, beta_U_mab_virus_28_0_292, beta_U_mab_virus_28_0_322, beta_U_mab_virus_6_0_233, beta_U_mab_virus_65_0_103, beta_U_mab_virus_65_0_292, beta_U_mab_virus_65_0_322, beta_U_mab_virus_69_0_103, beta_U_mab_virus_69_0_233, beta_U_mab_virus_69_0_274, beta_U_mab_virus_69_0_292, beta_U_mab_virus_69_0_322, beta_U_mab_virus_70_0_274, beta_L_gap_mab_virus_22_0_292, beta_L_gap_mab_virus_22_0_322, beta_L_gap_mab_virus_28_0_103, beta_L_gap_mab_virus_28_0_292, beta_L_gap_mab_virus_28_0_322, beta_L_gap_mab_virus_6_0_233, beta_L_gap_mab_virus_65_0_103, beta_L_gap_mab_virus_65_0_292, beta_L_gap_mab_virus_65_0_322, beta_L_gap_mab_virus_69_0_103, beta_L_gap_mab_virus_69_0_233, beta_L_gap_mab_virus_69_0_274, beta_L_gap_mab_virus_69_0_292, beta_L_gap_mab_virus_69_0_322, beta_L_gap_mab_virus_70_0_274, run_id, beta_U_run_id_1197, beta_U_run_id_152, beta_U_run_id_411, beta_U_run_id_705, beta_L_run_id_1197, beta_L_run_id_152, beta_L_run_id_411, beta_L_run_id_705, beta_alpha_run_id_1197, beta_alpha_run_id_152, beta_alpha_run_id_411, beta_alpha_run_id_705}

goes_down = {type=categorical, categories={'False', 'True'}}
mab_virus = {type=categorical, categories={'22.0|103', '22.0|292', '22.0|322', '28.0|103', '28.0|292', '28.0|322', '6.0|233', '65.0|103', '65.0|292', '65.0|322', '69.0|103', '69.0|233', '69.0|274', '69.0|292', '69.0|322', '70.0|274'}}
run_id = {type=categorical, categories={'1159', '1197', '152', '411', '705'}}

DEFINITION:
U = {distribution=normal, typical=U_pop, covariate={mab_virus, goes_down, run_id}, coefficient={{0, beta_U_mab_virus_22_0_292, beta_U_mab_virus_22_0_322, beta_U_mab_virus_28_0_103, beta_U_mab_virus_28_0_292, beta_U_mab_virus_28_0_322, beta_U_mab_virus_6_0_233, beta_U_mab_virus_65_0_103, beta_U_mab_virus_65_0_292, beta_U_mab_virus_65_0_322, beta_U_mab_virus_69_0_103, beta_U_mab_virus_69_0_233, beta_U_mab_virus_69_0_274, beta_U_mab_virus_69_0_292, beta_U_mab_virus_69_0_322, beta_U_mab_virus_70_0_274}, {0, beta_U_goes_down_True}, {0, beta_U_run_id_1197, beta_U_run_id_152, beta_U_run_id_411, beta_U_run_id_705}}, sd=omega_U}
L = {distribution=normal, typical=L_pop, covariate=run_id, coefficient={0, beta_L_run_id_1197, beta_L_run_id_152, beta_L_run_id_411, beta_L_run_id_705}, no-variability}
L_gap = {distribution=logNormal, typical=L_gap_pop, covariate={mab_virus, goes_down}, coefficient={{0, beta_L_gap_mab_virus_22_0_292, beta_L_gap_mab_virus_22_0_322, beta_L_gap_mab_virus_28_0_103, beta_L_gap_mab_virus_28_0_292, beta_L_gap_mab_virus_28_0_322, beta_L_gap_mab_virus_6_0_233, beta_L_gap_mab_virus_65_0_103, beta_L_gap_mab_virus_65_0_292, beta_L_gap_mab_virus_65_0_322, beta_L_gap_mab_virus_69_0_103, beta_L_gap_mab_virus_69_0_233, beta_L_gap_mab_virus_69_0_274, beta_L_gap_mab_virus_69_0_292, beta_L_gap_mab_virus_69_0_322, beta_L_gap_mab_virus_70_0_274}, {0, beta_L_gap_goes_down_True}}, sd=omega_L_gap}
h = {distribution=normal, typical=h_pop, sd=omega_h}
f = {distribution=logNormal, typical=f_pop, sd=omega_f}
alpha = {distribution=normal, typical=alpha_pop, covariate=run_id, coefficient={0, beta_alpha_run_id_1197, beta_alpha_run_id_152, beta_alpha_run_id_411, beta_alpha_run_id_705}, no-variability}

[LONGITUDINAL]
input = {a, b}

file = '../4pl_plate_fit_v5_model.txt'

DEFINITION:
rlu = {distribution=normal, prediction=RLU_all, errorModel=combined1(a, b)}

<FIT>
data = 'rlu'
model = rlu

