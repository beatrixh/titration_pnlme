<DATAFILE>

[FILEINFO]
file={path='../../../input_data/retagged_data/six_plates_with_estimates_2026-08-29.csv'}
delimiter = comma
header={monolix_id_update, concentration, rlu, plate_row, plate_col, run_id, mab_virus, binary_vc, binary_cc, binary_sample, U_estimate, L_estimate, alpha_estimate}

[CONTENT]
monolix_id_update = {use=identifier}
concentration = {use=time}
rlu = {use=observation, type=continuous}
plate_row = {use=regressor}
plate_col = {use=regressor}
run_id = {use=covariate, type=categorical}
mab_virus = {use=covariate, type=categorical}
binary_vc = {use=regressor}
binary_cc = {use=regressor}
binary_sample = {use=regressor}
U_estimate = {use=regressor}
L_estimate = {use=regressor}
alpha_estimate = {use=regressor}

<MODEL>

[COVARIATE]
input = {mab_virus, run_id}

mab_virus = {type=categorical, categories={'22.0|103', '22.0|276', '22.0|292', '22.0|322', '28.0|103', '28.0|276', '28.0|292', '28.0|322', '32.0|292', '55.0|292', '65.0|103', '65.0|276', '65.0|292', '65.0|322', '69.0|103', '69.0|274', '69.0|276', '69.0|292', '69.0|322', '70.0|274'}}
run_id = {type=categorical, categories={'1056', '1159', '1197', '152', '411', '462'}}

[INDIVIDUAL]
input = {h_pop, f_pop, L_gap_pop, mab_virus, beta_f_mab_virus_22_0_276, beta_f_mab_virus_22_0_292, beta_f_mab_virus_22_0_322, beta_f_mab_virus_28_0_103, beta_f_mab_virus_28_0_276, beta_f_mab_virus_28_0_292, beta_f_mab_virus_28_0_322, beta_f_mab_virus_32_0_292, beta_f_mab_virus_55_0_292, beta_f_mab_virus_65_0_103, beta_f_mab_virus_65_0_276, beta_f_mab_virus_65_0_292, beta_f_mab_virus_65_0_322, beta_f_mab_virus_69_0_103, beta_f_mab_virus_69_0_274, beta_f_mab_virus_69_0_276, beta_f_mab_virus_69_0_292, beta_f_mab_virus_69_0_322, beta_f_mab_virus_70_0_274, run_id, beta_h_run_id_1159, beta_h_run_id_1197, beta_h_run_id_152, beta_h_run_id_411, beta_h_run_id_462, beta_L_gap_run_id_1159, beta_L_gap_run_id_1197, beta_L_gap_run_id_152, beta_L_gap_run_id_411, beta_L_gap_run_id_462}

mab_virus = {type=categorical, categories={'22.0|103', '22.0|276', '22.0|292', '22.0|322', '28.0|103', '28.0|276', '28.0|292', '28.0|322', '32.0|292', '55.0|292', '65.0|103', '65.0|276', '65.0|292', '65.0|322', '69.0|103', '69.0|274', '69.0|276', '69.0|292', '69.0|322', '70.0|274'}}
run_id = {type=categorical, categories={'1056', '1159', '1197', '152', '411', '462'}}

DEFINITION:
h = {distribution=normal, typical=h_pop, covariate=run_id, coefficient={0, beta_h_run_id_1159, beta_h_run_id_1197, beta_h_run_id_152, beta_h_run_id_411, beta_h_run_id_462}, no-variability}
f = {distribution=logNormal, typical=f_pop, covariate=mab_virus, coefficient={0, beta_f_mab_virus_22_0_276, beta_f_mab_virus_22_0_292, beta_f_mab_virus_22_0_322, beta_f_mab_virus_28_0_103, beta_f_mab_virus_28_0_276, beta_f_mab_virus_28_0_292, beta_f_mab_virus_28_0_322, beta_f_mab_virus_32_0_292, beta_f_mab_virus_55_0_292, beta_f_mab_virus_65_0_103, beta_f_mab_virus_65_0_276, beta_f_mab_virus_65_0_292, beta_f_mab_virus_65_0_322, beta_f_mab_virus_69_0_103, beta_f_mab_virus_69_0_274, beta_f_mab_virus_69_0_276, beta_f_mab_virus_69_0_292, beta_f_mab_virus_69_0_322, beta_f_mab_virus_70_0_274}, no-variability}
L_gap = {distribution=normal, typical=L_gap_pop, covariate=run_id, coefficient={0, beta_L_gap_run_id_1159, beta_L_gap_run_id_1197, beta_L_gap_run_id_152, beta_L_gap_run_id_411, beta_L_gap_run_id_462}, no-variability}

[LONGITUDINAL]
input = {a, b}

file = '../4pl_plate_fit_with_estimates_v6_model.txt'

DEFINITION:
rlu = {distribution=normal, prediction=RLU_all, errorModel=combined1(a, b)}

<FIT>
data = 'rlu'
model = rlu

