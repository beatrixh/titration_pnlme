<DATAFILE>

[FILEINFO]
file={path='../../../input_data/retagged_data/six_plates_with_estimates_specrole_2026-08-30.csv'}
delimiter = comma
header={id, monolix_id_update, specrole, concentration, rlu, run_id, mab_virus, binary_vc, binary_cc, binary_sample, plate_row, plate_col, U_estimate, L_estimate, alpha_estimate}

[CONTENT]
id = {use=identifier}
specrole = {use=observationtype}
concentration = {use=time}
rlu = {use=observation, yname={'cc', 'sample', 'vc'}, type={continuous, continuous, continuous}}
run_id = {use=covariate, type=categorical}
mab_virus = {use=covariate, type=categorical}
plate_row = {use=regressor}
plate_col = {use=regressor}
U_estimate = {use=regressor}
L_estimate = {use=regressor}
alpha_estimate = {use=regressor}

<MODEL>

[COVARIATE]
input = {mab_virus, run_id}

mab_virus = {type=categorical, categories={'22.0|103', '22.0|276', '22.0|292', '22.0|322', '28.0|103', '28.0|276', '28.0|292', '28.0|322', '32.0|292', '55.0|292', '65.0|103', '65.0|276', '65.0|292', '65.0|322', '69.0|103', '69.0|274', '69.0|276', '69.0|292', '69.0|322', '70.0|274'}}
run_id = {type=categorical, categories={'1056', '1159', '1197', '152', '411', '462'}}

[INDIVIDUAL]
input = {L_gap_pop, f_pop, h_pop, mab_virus, beta_f_mab_virus_22_0_276, beta_f_mab_virus_22_0_292, beta_f_mab_virus_22_0_322, beta_f_mab_virus_28_0_103, beta_f_mab_virus_28_0_276, beta_f_mab_virus_28_0_292, beta_f_mab_virus_28_0_322, beta_f_mab_virus_32_0_292, beta_f_mab_virus_55_0_292, beta_f_mab_virus_65_0_103, beta_f_mab_virus_65_0_276, beta_f_mab_virus_65_0_292, beta_f_mab_virus_65_0_322, beta_f_mab_virus_69_0_103, beta_f_mab_virus_69_0_274, beta_f_mab_virus_69_0_276, beta_f_mab_virus_69_0_292, beta_f_mab_virus_69_0_322, beta_f_mab_virus_70_0_274, beta_h_mab_virus_22_0_276, beta_h_mab_virus_22_0_292, beta_h_mab_virus_22_0_322, beta_h_mab_virus_28_0_103, beta_h_mab_virus_28_0_276, beta_h_mab_virus_28_0_292, beta_h_mab_virus_28_0_322, beta_h_mab_virus_32_0_292, beta_h_mab_virus_55_0_292, beta_h_mab_virus_65_0_103, beta_h_mab_virus_65_0_276, beta_h_mab_virus_65_0_292, beta_h_mab_virus_65_0_322, beta_h_mab_virus_69_0_103, beta_h_mab_virus_69_0_274, beta_h_mab_virus_69_0_276, beta_h_mab_virus_69_0_292, beta_h_mab_virus_69_0_322, beta_h_mab_virus_70_0_274, beta_L_gap_mab_virus_22_0_276, beta_L_gap_mab_virus_22_0_292, beta_L_gap_mab_virus_22_0_322, beta_L_gap_mab_virus_28_0_103, beta_L_gap_mab_virus_28_0_276, beta_L_gap_mab_virus_28_0_292, beta_L_gap_mab_virus_28_0_322, beta_L_gap_mab_virus_32_0_292, beta_L_gap_mab_virus_55_0_292, beta_L_gap_mab_virus_65_0_103, beta_L_gap_mab_virus_65_0_276, beta_L_gap_mab_virus_65_0_292, beta_L_gap_mab_virus_65_0_322, beta_L_gap_mab_virus_69_0_103, beta_L_gap_mab_virus_69_0_274, beta_L_gap_mab_virus_69_0_276, beta_L_gap_mab_virus_69_0_292, beta_L_gap_mab_virus_69_0_322, beta_L_gap_mab_virus_70_0_274, run_id, beta_L_gap_run_id_1159, beta_L_gap_run_id_1197, beta_L_gap_run_id_152, beta_L_gap_run_id_411, beta_L_gap_run_id_462, omega_f, omega_h, omega_L_gap}

mab_virus = {type=categorical, categories={'22.0|103', '22.0|276', '22.0|292', '22.0|322', '28.0|103', '28.0|276', '28.0|292', '28.0|322', '32.0|292', '55.0|292', '65.0|103', '65.0|276', '65.0|292', '65.0|322', '69.0|103', '69.0|274', '69.0|276', '69.0|292', '69.0|322', '70.0|274'}}
run_id = {type=categorical, categories={'1056', '1159', '1197', '152', '411', '462'}}

DEFINITION:
L_gap = {distribution=normal, typical=L_gap_pop, covariate={mab_virus, run_id}, coefficient={{0, beta_L_gap_mab_virus_22_0_276, beta_L_gap_mab_virus_22_0_292, beta_L_gap_mab_virus_22_0_322, beta_L_gap_mab_virus_28_0_103, beta_L_gap_mab_virus_28_0_276, beta_L_gap_mab_virus_28_0_292, beta_L_gap_mab_virus_28_0_322, beta_L_gap_mab_virus_32_0_292, beta_L_gap_mab_virus_55_0_292, beta_L_gap_mab_virus_65_0_103, beta_L_gap_mab_virus_65_0_276, beta_L_gap_mab_virus_65_0_292, beta_L_gap_mab_virus_65_0_322, beta_L_gap_mab_virus_69_0_103, beta_L_gap_mab_virus_69_0_274, beta_L_gap_mab_virus_69_0_276, beta_L_gap_mab_virus_69_0_292, beta_L_gap_mab_virus_69_0_322, beta_L_gap_mab_virus_70_0_274}, {0, beta_L_gap_run_id_1159, beta_L_gap_run_id_1197, beta_L_gap_run_id_152, beta_L_gap_run_id_411, beta_L_gap_run_id_462}}, sd=omega_L_gap}
f = {distribution=logNormal, typical=f_pop, covariate=mab_virus, coefficient={0, beta_f_mab_virus_22_0_276, beta_f_mab_virus_22_0_292, beta_f_mab_virus_22_0_322, beta_f_mab_virus_28_0_103, beta_f_mab_virus_28_0_276, beta_f_mab_virus_28_0_292, beta_f_mab_virus_28_0_322, beta_f_mab_virus_32_0_292, beta_f_mab_virus_55_0_292, beta_f_mab_virus_65_0_103, beta_f_mab_virus_65_0_276, beta_f_mab_virus_65_0_292, beta_f_mab_virus_65_0_322, beta_f_mab_virus_69_0_103, beta_f_mab_virus_69_0_274, beta_f_mab_virus_69_0_276, beta_f_mab_virus_69_0_292, beta_f_mab_virus_69_0_322, beta_f_mab_virus_70_0_274}, sd=omega_f}
h = {distribution=normal, typical=h_pop, covariate=mab_virus, coefficient={0, beta_h_mab_virus_22_0_276, beta_h_mab_virus_22_0_292, beta_h_mab_virus_22_0_322, beta_h_mab_virus_28_0_103, beta_h_mab_virus_28_0_276, beta_h_mab_virus_28_0_292, beta_h_mab_virus_28_0_322, beta_h_mab_virus_32_0_292, beta_h_mab_virus_55_0_292, beta_h_mab_virus_65_0_103, beta_h_mab_virus_65_0_276, beta_h_mab_virus_65_0_292, beta_h_mab_virus_65_0_322, beta_h_mab_virus_69_0_103, beta_h_mab_virus_69_0_274, beta_h_mab_virus_69_0_276, beta_h_mab_virus_69_0_292, beta_h_mab_virus_69_0_322, beta_h_mab_virus_70_0_274}, sd=omega_h}

[LONGITUDINAL]
input = {acc, bcc, asample, bsample, avc, bvc}

file = '../4pl_plate_fit_with_estimates_v7_model.txt'

DEFINITION:
ycc = {distribution=normal, prediction=RLU_cc, errorModel=combined1(acc, bcc)}
ysample = {distribution=normal, prediction=RLU_sample, errorModel=combined1(asample, bsample)}
yvc = {distribution=normal, prediction=RLU_vc, errorModel=combined1(avc, bvc)}

<FIT>
data = {'cc', 'sample', 'vc'}
model = {ycc, ysample, yvc}

