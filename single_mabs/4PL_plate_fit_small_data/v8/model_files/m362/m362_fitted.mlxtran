<DATAFILE>

[FILEINFO]
file={path='../../../../input_data/retagged_data/six_plates_with_estimates_specrole_2026-08-30.csv'}
delimiter = comma
header={id, monolix_id_update, specrole, concentration, rlu, run_id, mab_virus, binary_vc, binary_cc, binary_sample, plate_row, plate_col, U_estimate, L_estimate, alpha_estimate}

[CONTENT]
id = {use=identifier}
specrole = {use=observationtype}
concentration = {use=time}
rlu = {use=observation, yname={'cc', 'sample', 'vc'}, type={continuous, continuous, continuous}}
run_id = {use=covariate, type=categorical}
mab_virus = {use=covariate, type=categorical}
plate_row = {use=regressor}
plate_col = {use=regressor}
U_estimate = {use=regressor}
L_estimate = {use=regressor}
alpha_estimate = {use=regressor}

<MODEL>

[POPULATION]
DEFINITION:
eta_alpha_pop = {distribution=normal, typical=0, sd=1}

[COVARIATE]
input = {mab_virus, run_id}

mab_virus = {type=categorical, categories={'22.0|103', '22.0|276', '22.0|292', '22.0|322', '28.0|103', '28.0|276', '28.0|292', '28.0|322', '32.0|292', '55.0|292', '65.0|103', '65.0|276', '65.0|292', '65.0|322', '69.0|103', '69.0|274', '69.0|276', '69.0|292', '69.0|322', '70.0|274'}}
run_id = {type=categorical, categories={'1056', '1159', '1197', '152', '411', '462'}}

[INDIVIDUAL]
input = {h_pop, omega_h, f_pop, omega_f, L_gap_pop, eta_alpha_pop, run_id, beta_h_run_id_1159, beta_h_run_id_1197, beta_h_run_id_152, beta_h_run_id_411, beta_h_run_id_462, beta_f_run_id_1159, beta_f_run_id_1197, beta_f_run_id_152, beta_f_run_id_411, beta_f_run_id_462, beta_L_gap_run_id_1159, beta_L_gap_run_id_1197, beta_L_gap_run_id_152, beta_L_gap_run_id_411, beta_L_gap_run_id_462, beta_eta_alpha_run_id_1159, beta_eta_alpha_run_id_1197, beta_eta_alpha_run_id_152, beta_eta_alpha_run_id_411, beta_eta_alpha_run_id_462}

run_id = {type=categorical, categories={'1056', '1159', '1197', '152', '411', '462'}}

DEFINITION:
h = {distribution=normal, typical=h_pop, covariate=run_id, coefficient={0, beta_h_run_id_1159, beta_h_run_id_1197, beta_h_run_id_152, beta_h_run_id_411, beta_h_run_id_462}, sd=omega_h}
f = {distribution=logNormal, typical=f_pop, covariate=run_id, coefficient={0, beta_f_run_id_1159, beta_f_run_id_1197, beta_f_run_id_152, beta_f_run_id_411, beta_f_run_id_462}, sd=omega_f}
L_gap = {distribution=normal, typical=L_gap_pop, covariate=run_id, coefficient={0, beta_L_gap_run_id_1159, beta_L_gap_run_id_1197, beta_L_gap_run_id_152, beta_L_gap_run_id_411, beta_L_gap_run_id_462}, no-variability}
eta_alpha = {distribution=normal, typical=eta_alpha_pop, covariate=run_id, coefficient={0, beta_eta_alpha_run_id_1159, beta_eta_alpha_run_id_1197, beta_eta_alpha_run_id_152, beta_eta_alpha_run_id_411, beta_eta_alpha_run_id_462}, no-variability}

[LONGITUDINAL]
input = {acc, bcc, asample, bsample, avc, bvc}

file = '../../4pl_plate_fit_with_estimates_v8_model.txt'

DEFINITION:
ycc = {distribution=normal, prediction=RLU_cc, errorModel=combined1(acc, bcc)}
ysample = {distribution=normal, prediction=RLU_sample, errorModel=combined1(asample, bsample)}
yvc = {distribution=normal, prediction=RLU_vc, errorModel=combined1(avc, bvc)}

<FIT>
data = {'cc', 'sample', 'vc'}
model = {ycc, ysample, yvc}

<PARAMETER>
L_gap_pop = {value=-24.22, method=MLE}
acc = {value=161.62128, method=MLE}
asample = {value=30.19173, method=MLE}
avc = {value=0.1423958, method=MLE}
bcc = {value=0.000000000000001, method=MLE}
beta_L_gap_run_id_1159 = {value=0.06524964, method=MLE}
beta_L_gap_run_id_1197 = {value=1.75083, method=MLE}
beta_L_gap_run_id_152 = {value=-2.30972, method=MLE}
beta_L_gap_run_id_411 = {value=-1.98081, method=MLE}
beta_L_gap_run_id_462 = {value=-4.51289, method=MLE}
beta_eta_alpha_run_id_1159 = {value=0, method=MLE}
beta_eta_alpha_run_id_1197 = {value=0, method=MLE}
beta_eta_alpha_run_id_152 = {value=0, method=MLE}
beta_eta_alpha_run_id_411 = {value=0, method=MLE}
beta_eta_alpha_run_id_462 = {value=0, method=MLE}
beta_f_run_id_1159 = {value=0, method=MLE}
beta_f_run_id_1197 = {value=0, method=MLE}
beta_f_run_id_152 = {value=0, method=MLE}
beta_f_run_id_411 = {value=0, method=MLE}
beta_f_run_id_462 = {value=0, method=MLE}
beta_h_run_id_1159 = {value=0, method=MLE}
beta_h_run_id_1197 = {value=0, method=MLE}
beta_h_run_id_152 = {value=0, method=MLE}
beta_h_run_id_411 = {value=0, method=MLE}
beta_h_run_id_462 = {value=0, method=MLE}
bsample = {value=0.152522, method=MLE}
bvc = {value=0.04253407, method=MLE}
ccc = {value=1, method=FIXED}
csample = {value=1, method=FIXED}
cvc = {value=1, method=FIXED}
eta_alpha_pop = {value=0, method=MAP}
f_pop = {value=0.477, method=MLE}
h_pop = {value=1.764, method=MLE}
omega_f = {value=2.3650574, method=MLE}
omega_h = {value=0.00000004847476, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMean, conditionalMode })
fim(method = StochasticApproximation)
logLikelihood(method = ImportanceSampling)

[PLOTS]
run = true
plots = {indfits = {selected = true}, parameterdistribution = {selected = true}, obspred = {selected = true}, covariancemodeldiagnosis = {selected = true}, covariatemodeldiagnosis = {selected = true}, vpc = {selected = true}, residualsscatter = {selected = true}, residualsdistribution = {selected = true}, randomeffects = {selected = true}, saemresults = {selected = true}}

[SETTINGS]
GLOBAL:
exportpath = 'm362_fitted'

POPULATION:
exploratoryiterations = 2000
simulatedannealingiterations = 2000

INDIVIDUAL:
optimizationiterations = 2000

