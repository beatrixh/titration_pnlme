<DATAFILE>

[FILEINFO]
file={path='../../../../input_data/retagged_data/six_plates_controls_only_2026-08-29.csv'}
delimiter = comma
header={run_id, run_name, plate_row, plate_col, rlu, min_diff, specrole, run, virus_name, concentration, monolix_id, rlu_max, rlu_min, rlu_norm, virus_col, mab, mablot, mab_virus, goes_down, virus_cc, id_unique, monolix_id_update, id_unique_update, mean_vc, mean_cc, binary_vc, binary_cc, binary_sample}

[CONTENT]
run_id = {use=identifier}
plate_row = {use=time}
rlu = {use=observation, yname={'cc', 'vc'}, type={continuous, continuous}}
specrole = {use=observationtype}
mean_cc = {use=covariate, type=categorical}

<MODEL>

[COVARIATE]
input = mean_cc

mean_cc = {type=categorical, categories={'636.5', '643.5', '654.75', '695.25', '713.75', '910.0'}}

[INDIVIDUAL]
input = {L_pop, U_pop, alpha_pop, mean_cc, beta_U_mean_cc_643_5, beta_U_mean_cc_654_75, beta_U_mean_cc_695_25, beta_U_mean_cc_713_75, beta_U_mean_cc_910_0, beta_L_mean_cc_643_5, beta_L_mean_cc_654_75, beta_L_mean_cc_695_25, beta_L_mean_cc_713_75, beta_L_mean_cc_910_0, beta_alpha_mean_cc_643_5, beta_alpha_mean_cc_654_75, beta_alpha_mean_cc_695_25, beta_alpha_mean_cc_713_75, beta_alpha_mean_cc_910_0}

mean_cc = {type=categorical, categories={'636.5', '643.5', '654.75', '695.25', '713.75', '910.0'}}

DEFINITION:
L = {distribution=normal, typical=L_pop, covariate=mean_cc, coefficient={0, beta_L_mean_cc_643_5, beta_L_mean_cc_654_75, beta_L_mean_cc_695_25, beta_L_mean_cc_713_75, beta_L_mean_cc_910_0}, no-variability}
U = {distribution=normal, typical=U_pop, covariate=mean_cc, coefficient={0, beta_U_mean_cc_643_5, beta_U_mean_cc_654_75, beta_U_mean_cc_695_25, beta_U_mean_cc_713_75, beta_U_mean_cc_910_0}, no-variability}
alpha = {distribution=logNormal, typical=alpha_pop, covariate=mean_cc, coefficient={0, beta_alpha_mean_cc_643_5, beta_alpha_mean_cc_654_75, beta_alpha_mean_cc_695_25, beta_alpha_mean_cc_713_75, beta_alpha_mean_cc_910_0}, no-variability}

[LONGITUDINAL]
input = {acc, bcc, avc, bvc}

file = '../dist_to_nearest_edge_controls_model.txt'

DEFINITION:
ycc = {distribution=normal, prediction=RLU_cc, errorModel=combined1(acc, bcc)}
yvc = {distribution=normal, prediction=RLU_vc, errorModel=combined1(avc, bvc)}

<FIT>
data = {'cc', 'vc'}
model = {ycc, yvc}

<PARAMETER>
L_pop = {value=700, method=MLE}
U_pop = {value=110012, method=MLE}
acc = {value=1, method=MLE}
alpha_pop = {value=0.5, method=MLE}
avc = {value=1, method=MLE}
bcc = {value=0.3, method=MLE}
beta_L_mean_cc_643_5 = {value=0, method=MLE}
beta_L_mean_cc_654_75 = {value=0, method=MLE}
beta_L_mean_cc_695_25 = {value=0, method=MLE}
beta_L_mean_cc_713_75 = {value=0, method=MLE}
beta_L_mean_cc_910_0 = {value=0, method=MLE}
beta_U_mean_cc_643_5 = {value=0, method=MLE}
beta_U_mean_cc_654_75 = {value=0, method=MLE}
beta_U_mean_cc_695_25 = {value=0, method=MLE}
beta_U_mean_cc_713_75 = {value=0, method=MLE}
beta_U_mean_cc_910_0 = {value=0, method=MLE}
beta_alpha_mean_cc_643_5 = {value=0, method=MLE}
beta_alpha_mean_cc_654_75 = {value=0, method=MLE}
beta_alpha_mean_cc_695_25 = {value=0, method=MLE}
beta_alpha_mean_cc_713_75 = {value=0, method=MLE}
beta_alpha_mean_cc_910_0 = {value=0, method=MLE}
bvc = {value=0.3, method=MLE}
ccc = {value=1, method=FIXED}
cvc = {value=1, method=FIXED}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMean, conditionalMode })
fim(method = StochasticApproximation)
logLikelihood(method = ImportanceSampling)

[PLOTS]
run = true
plots = {indfits = {selected = true}, parameterdistribution = {selected = true}, obspred = {selected = true}, covariancemodeldiagnosis = {selected = true}, covariatemodeldiagnosis = {selected = true}, vpc = {selected = true}, residualsscatter = {selected = true}, residualsdistribution = {selected = true}, randomeffects = {selected = true}, saemresults = {selected = true}}

[SETTINGS]
GLOBAL:
exportpath = 'm0_alpha_lognormal2'

POPULATION:
smoothingiterations = 500
exploratoryiterations = 2000
simulatedannealingiterations = 2000

