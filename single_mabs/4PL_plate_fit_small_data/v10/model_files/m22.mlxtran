<DATAFILE>

[FILEINFO]
file={path='../../../input_data/retagged_data/six_plates_with_estimates_specrole_2026-08-30.csv'}
delimiter = comma
header={id, monolix_id_update, specrole, concentration, rlu, run_id, mab_virus, binary_vc, binary_cc, binary_sample, plate_row, plate_col, U_estimate, L_estimate, alpha_estimate}

[CONTENT]
id = {use=identifier}
specrole = {use=observationtype}
concentration = {use=time}
rlu = {use=observation, yname={'cc', 'sample', 'vc'}, type={continuous, continuous, continuous}}
run_id = {use=covariate, type=categorical}
mab_virus = {use=covariate, type=categorical}
plate_row = {use=regressor}
plate_col = {use=regressor}
U_estimate = {use=regressor}
L_estimate = {use=regressor}
alpha_estimate = {use=regressor}

<MODEL>

[POPULATION]
DEFINITION:
eta_alpha_pop = {distribution=normal, typical=0, sd=1}
eta_U_pop = {distribution=normal, typical=0, sd=1}
eta_L_pop = {distribution=normal, typical=0, sd=1}

[COVARIATE]
input = {mab_virus, run_id}

mab_virus = {type=categorical, categories={'22.0|103', '22.0|276', '22.0|292', '22.0|322', '28.0|103', '28.0|276', '28.0|292', '28.0|322', '32.0|292', '55.0|292', '65.0|103', '65.0|276', '65.0|292', '65.0|322', '69.0|103', '69.0|274', '69.0|276', '69.0|292', '69.0|322', '70.0|274'}}
run_id = {type=categorical, categories={'1056', '1159', '1197', '152', '411', '462'}}

[INDIVIDUAL]
input = {h_pop, omega_h, f_pop, eta_L_pop, omega_eta_L, eta_alpha_pop, eta_U_pop, omega_eta_U, mab_virus, beta_h_mab_virus_22_0_276, beta_h_mab_virus_22_0_292, beta_h_mab_virus_22_0_322, beta_h_mab_virus_28_0_103, beta_h_mab_virus_28_0_276, beta_h_mab_virus_28_0_292, beta_h_mab_virus_28_0_322, beta_h_mab_virus_32_0_292, beta_h_mab_virus_55_0_292, beta_h_mab_virus_65_0_103, beta_h_mab_virus_65_0_276, beta_h_mab_virus_65_0_292, beta_h_mab_virus_65_0_322, beta_h_mab_virus_69_0_103, beta_h_mab_virus_69_0_274, beta_h_mab_virus_69_0_276, beta_h_mab_virus_69_0_292, beta_h_mab_virus_69_0_322, beta_h_mab_virus_70_0_274, beta_f_mab_virus_22_0_276, beta_f_mab_virus_22_0_292, beta_f_mab_virus_22_0_322, beta_f_mab_virus_28_0_103, beta_f_mab_virus_28_0_276, beta_f_mab_virus_28_0_292, beta_f_mab_virus_28_0_322, beta_f_mab_virus_32_0_292, beta_f_mab_virus_55_0_292, beta_f_mab_virus_65_0_103, beta_f_mab_virus_65_0_276, beta_f_mab_virus_65_0_292, beta_f_mab_virus_65_0_322, beta_f_mab_virus_69_0_103, beta_f_mab_virus_69_0_274, beta_f_mab_virus_69_0_276, beta_f_mab_virus_69_0_292, beta_f_mab_virus_69_0_322, beta_f_mab_virus_70_0_274, beta_eta_L_mab_virus_22_0_276, beta_eta_L_mab_virus_22_0_292, beta_eta_L_mab_virus_22_0_322, beta_eta_L_mab_virus_28_0_103, beta_eta_L_mab_virus_28_0_276, beta_eta_L_mab_virus_28_0_292, beta_eta_L_mab_virus_28_0_322, beta_eta_L_mab_virus_32_0_292, beta_eta_L_mab_virus_55_0_292, beta_eta_L_mab_virus_65_0_103, beta_eta_L_mab_virus_65_0_276, beta_eta_L_mab_virus_65_0_292, beta_eta_L_mab_virus_65_0_322, beta_eta_L_mab_virus_69_0_103, beta_eta_L_mab_virus_69_0_274, beta_eta_L_mab_virus_69_0_276, beta_eta_L_mab_virus_69_0_292, beta_eta_L_mab_virus_69_0_322, beta_eta_L_mab_virus_70_0_274, run_id, beta_h_run_id_1159, beta_h_run_id_1197, beta_h_run_id_152, beta_h_run_id_411, beta_h_run_id_462, beta_eta_L_run_id_1159, beta_eta_L_run_id_1197, beta_eta_L_run_id_152, beta_eta_L_run_id_411, beta_eta_L_run_id_462, beta_eta_alpha_run_id_1159, beta_eta_alpha_run_id_1197, beta_eta_alpha_run_id_152, beta_eta_alpha_run_id_411, beta_eta_alpha_run_id_462, beta_eta_U_run_id_1159, beta_eta_U_run_id_1197, beta_eta_U_run_id_152, beta_eta_U_run_id_411, beta_eta_U_run_id_462}

mab_virus = {type=categorical, categories={'22.0|103', '22.0|276', '22.0|292', '22.0|322', '28.0|103', '28.0|276', '28.0|292', '28.0|322', '32.0|292', '55.0|292', '65.0|103', '65.0|276', '65.0|292', '65.0|322', '69.0|103', '69.0|274', '69.0|276', '69.0|292', '69.0|322', '70.0|274'}}
run_id = {type=categorical, categories={'1056', '1159', '1197', '152', '411', '462'}}

DEFINITION:
h = {distribution=normal, typical=h_pop, covariate={mab_virus, run_id}, coefficient={{0, beta_h_mab_virus_22_0_276, beta_h_mab_virus_22_0_292, beta_h_mab_virus_22_0_322, beta_h_mab_virus_28_0_103, beta_h_mab_virus_28_0_276, beta_h_mab_virus_28_0_292, beta_h_mab_virus_28_0_322, beta_h_mab_virus_32_0_292, beta_h_mab_virus_55_0_292, beta_h_mab_virus_65_0_103, beta_h_mab_virus_65_0_276, beta_h_mab_virus_65_0_292, beta_h_mab_virus_65_0_322, beta_h_mab_virus_69_0_103, beta_h_mab_virus_69_0_274, beta_h_mab_virus_69_0_276, beta_h_mab_virus_69_0_292, beta_h_mab_virus_69_0_322, beta_h_mab_virus_70_0_274}, {0, beta_h_run_id_1159, beta_h_run_id_1197, beta_h_run_id_152, beta_h_run_id_411, beta_h_run_id_462}}, sd=omega_h}
f = {distribution=logNormal, typical=f_pop, covariate=mab_virus, coefficient={0, beta_f_mab_virus_22_0_276, beta_f_mab_virus_22_0_292, beta_f_mab_virus_22_0_322, beta_f_mab_virus_28_0_103, beta_f_mab_virus_28_0_276, beta_f_mab_virus_28_0_292, beta_f_mab_virus_28_0_322, beta_f_mab_virus_32_0_292, beta_f_mab_virus_55_0_292, beta_f_mab_virus_65_0_103, beta_f_mab_virus_65_0_276, beta_f_mab_virus_65_0_292, beta_f_mab_virus_65_0_322, beta_f_mab_virus_69_0_103, beta_f_mab_virus_69_0_274, beta_f_mab_virus_69_0_276, beta_f_mab_virus_69_0_292, beta_f_mab_virus_69_0_322, beta_f_mab_virus_70_0_274}, no-variability}
eta_L = {distribution=normal, typical=eta_L_pop, covariate={mab_virus, run_id}, coefficient={{0, beta_eta_L_mab_virus_22_0_276, beta_eta_L_mab_virus_22_0_292, beta_eta_L_mab_virus_22_0_322, beta_eta_L_mab_virus_28_0_103, beta_eta_L_mab_virus_28_0_276, beta_eta_L_mab_virus_28_0_292, beta_eta_L_mab_virus_28_0_322, beta_eta_L_mab_virus_32_0_292, beta_eta_L_mab_virus_55_0_292, beta_eta_L_mab_virus_65_0_103, beta_eta_L_mab_virus_65_0_276, beta_eta_L_mab_virus_65_0_292, beta_eta_L_mab_virus_65_0_322, beta_eta_L_mab_virus_69_0_103, beta_eta_L_mab_virus_69_0_274, beta_eta_L_mab_virus_69_0_276, beta_eta_L_mab_virus_69_0_292, beta_eta_L_mab_virus_69_0_322, beta_eta_L_mab_virus_70_0_274}, {0, beta_eta_L_run_id_1159, beta_eta_L_run_id_1197, beta_eta_L_run_id_152, beta_eta_L_run_id_411, beta_eta_L_run_id_462}}, sd=omega_eta_L}
eta_alpha = {distribution=normal, typical=eta_alpha_pop, covariate=run_id, coefficient={0, beta_eta_alpha_run_id_1159, beta_eta_alpha_run_id_1197, beta_eta_alpha_run_id_152, beta_eta_alpha_run_id_411, beta_eta_alpha_run_id_462}, no-variability}
eta_U = {distribution=normal, typical=eta_U_pop, covariate=run_id, coefficient={0, beta_eta_U_run_id_1159, beta_eta_U_run_id_1197, beta_eta_U_run_id_152, beta_eta_U_run_id_411, beta_eta_U_run_id_462}, sd=omega_eta_U}

[LONGITUDINAL]
input = {acc, bcc, asample, bsample, avc, bvc}

file = '../4pl_plate_fit_with_estimates_v10_model.txt'

DEFINITION:
ycc = {distribution=normal, prediction=RLU_cc, errorModel=combined1(acc, bcc)}
ysample = {distribution=normal, prediction=RLU_sample, errorModel=combined1(asample, bsample)}
yvc = {distribution=normal, prediction=RLU_vc, errorModel=combined1(avc, bvc)}

<FIT>
