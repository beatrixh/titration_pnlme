<DATAFILE>

[FILEINFO]
file={path='../../../../input_data/retagged_data/100_plates_m4b_m5b_estimates_2026-09-12.csv'}
delimiter = comma
header={id, time, monolix_id_update, specrole, concentration, rlu, run_id, mab_virus, binary_vc, binary_cc, binary_sample, plate_row, plate_col, a_m4b, c_m4b, a_m5b, c_m5b, m_m5b, cc_mean}

[CONTENT]
